# CASEDECODER Server Environment Configuration

# Port for Express API server
PORT=5000

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# Optional for demo mode; if not provided or quota limited, high-fidelity extraction fallback will be used
GEMINI_API_KEY=

# Set to true to force sample judgment response for offline presentation
USE_OFFLINE_MOCK=false
